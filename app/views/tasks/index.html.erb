<h1>Task Management System</h1>

<%= link_to "New Task",
new_task_path %>

<table border="1">

<tr>
  <th>ID</th>
  <th>Name</th>
  <th>Description</th>
  <th>Due Date</th>
  <th>Priority</th>
  <th>Category</th>
  <th>Action</th>
</tr>

<% @tasks.each do |task| %>

<tr>
  <td><%= task.id %></td>
  <td><%= task.name %></td>
  <td><%= task.description %></td>
  <td><%= task.due_date %></td>
  <td><%= task.priority %></td>
  <td><%= task.category %></td>

  <td>
    <%= link_to "Edit",
    edit_task_path(task) %>

    <%= button_to "Delete",
    task_path(task),
    method: :delete %>
  </td>

</tr>

<% end %>

</table>